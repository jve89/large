{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "lib": ["esnext"],
    "types": ["node"],
    "jsx": "react-jsx",
    "incremental": false,
    "sourceMap": true,
    "plugins": []
  },
  "include": ["src/worker/**/*.ts", "src/core/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "src/app", "src/components"]
}
