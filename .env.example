# Large AI — every environment variable this project reads.
#
# Copy to `.env` and fill in. Secrets never enter the repository (.env is
# gitignored). Validation is role-aware and lives in src/lib/env.ts: a variable
# marked "worker + script" is deliberately NOT required by the web process, which
# never calls a provider — demanding it everywhere would put the web service into
# a restart loop on a host where only the worker holds the keys (SPEC C13).

# ── Database (all roles) ─────────────────────────────────────────────────────
# PostgreSQL major 18 is pinned and asserted at startup; a different major fails
# loudly naming both versions. Local development uses the same postgres:18 image
# that CI runs, so the local gate and the CI gate sit on an identical database:
#   docker run -d --name large-pg17 -e POSTGRES_USER=postgres \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=large -p 5432:5432 postgres:18
DATABASE_URL=""

# ── Provider API keys (worker + script only) ─────────────────────────────────
# A Claude Max subscription does not grant API access; an Anthropic Console
# account with prepaid credits does (as researched 2026-08-23; re-check, don't
# trust). Likewise ChatGPT Plus does not grant OpenAI API access.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── Tuning (all optional; the default is shown and is applied when unset) ─────
# Per provider, per worker process. With W workers the effective provider limit
# becomes W x this, because each process counts only itself.
PROVIDER_CONCURRENCY="4"
# A target whose coverage falls below this has its figures labelled unreliable
# rather than presented as a measurement (SPEC C10).
COVERAGE_THRESHOLD="0.8"
# How often the worker polls for a claimable run.
WORKER_POLL_MS="2000"
# A `running` run whose heartbeat is older than this may be reclaimed (SPEC C15).
STALE_RUN_SECONDS="120"
# Past this many reclaims a run is failed rather than retried forever (SPEC C15).
MAX_RECLAIMS="3"

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
